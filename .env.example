# Base de datos (Render PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Gemini API
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash

# Puerto del servidor
PORT=3000

# Secreto para tokens JWT/HMAC (cámbialo en producción)
TOKEN_SECRET=belcen-clave-sesion-cambiar-en-produccion

