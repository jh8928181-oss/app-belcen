# Base de datos (Render PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Gemini API
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-3.6-flash

# Puerto del servidor
PORT=3000

# Guards de rol por ruta.
# Sin definir o en false: los guards NO bloquean, solo registran un aviso
# [observa-roles] en la consola. Útil para medir el impacto antes de activarlos.
# En true: los guards responden 403 si el rol no está en la lista de la ruta.
# Actívalo solo cuando se haya validado que nadie legitimo pierde acceso.
# ENFORCE_ROLES=false

# Secreto para tokens JWT/HMAC (cámbialo en producción)
TOKEN_SECRET=belcen-clave-sesion-cambiar-en-produccion

# Contraseñas para usuarios semilla (SOLO DESARROLLO)
# Define una por cada usuario que quieras crear al correr poblar.js
# SEED_PWD_VIGILANCIA1=tu_password_aqui
# SEED_PWD_ALMACEN1=tu_password_aqui
# SEED_PWD_SOPLADO_USER=tu_password_aqui
# SEED_PWD_ENVASADO_USER=tu_password_aqui
# SEED_PWD_AUDITOR_USER=tu_password_aqui
# SEED_PWD_ING_BLAS=tu_password_aqui
# SEED_PWD_PARIONA=tu_password_aqui
# SEED_PWD_ACCESO_1=tu_password_aqui
# SEED_PWD_ACCESO_2=tu_password_aqui
# SEED_PWD_ADMIN1=tu_password_super_seguro_aqui

# NODE_ENV=development (por defecto) o production